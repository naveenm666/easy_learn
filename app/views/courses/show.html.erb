<h1>Course Details</h1>

<p><strong>Title:</strong> <%= @course.title %></p>
<p><strong>Technologies:</strong> <%= @course.technologies %></p>
<p><strong>Duration:</strong> <%= @course.duration %></p>
<p><strong>Content Page:</strong> <%= raw(@course.table_of_contents) %></p>
<p><strong>Course Type:</strong> <%= @course.course_type %></p>

<% if @course.price.present? %>
  <p><strong>Price:</strong> <%= number_to_currency(@course.price) %></p>
<% end %>

<% if @course.free.present? %>
  <p><strong>Free:</strong> <%= @course.free ? 'Yes' : 'No' %></p>
<% end %>

<%= link_to 'Back', tutor_courses_path(@tutor) %>
