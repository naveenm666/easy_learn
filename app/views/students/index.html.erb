<!-- app/views/students/index.html.erb -->

<h1>Welcome to the Student Portal</h1>

<% if student_signed_in? %>
  <p>Welcome, <%= "#{current_student.first_name} #{current_student.last_name}" %>!</p>
  <%= link_to 'Edit profile', edit_student_registration_path %>
  <%= link_to "Sign out", destroy_student_session_path, data: { turbo_method: :delete } %>
  <%= link_to "Transactions", student_transactions_path(current_student) %>
<% else %>
  <%= link_to 'Log in', new_student_session_path %>
  <%= link_to 'Sign up', new_student_registration_path %>
<% end %>

<h2>Available Courses:</h2>
<div class="course-cards">
  <% @courses.each do |course| %>
    <div class="course-card" data-course-id="<%= course.id %>" data-course-title="<%= course.title %>" data-course-price="<%= (course.price || 0) * 100 %>">
      <strong>Title:</strong> <%= course.title %><br>
      <strong>Technologies:</strong> <%= course.technologies %><br>
      <strong>Duration:</strong> <%= course.duration %><br>
      <% if course.price.nil? || course.price <= 0 %>
        <strong>Price:</strong> Free<br>
        <button class="enroll-button" data-course-id="<%= course.id %>">Enroll for Free</button>
      <% else %>
        <% if current_student.transactions.find_by(course_id: course.id).present? %>
          <% transaction = current_student.transactions.find_by(course_id: course.id) %>
          <% if transaction.order_id.present? && transaction.payment_id.present? && transaction.status == 'success' && !transaction.expired? %>
          <button class="btn btn-primary">view</button>
          <% else %>
            <!-- Display price and buy button -->
            <strong>Price:</strong> <%= number_to_currency(course.price, unit: '₹') %><br>
            <%= form_with url: buy_course_path(course), method: :post, local: true, html: { "data-turbo" => "false" } do |f| %>
              <%= hidden_field_tag :course_id, course.id %>
              <%= hidden_field_tag :course_price, (course.price * 100).to_i %>
              <%= f.submit 'Buy', class: 'btn btn-primary' %>
            <% end %>
          <% end %>
        <% else %>
          <!-- No transaction, display price and buy button -->
          <strong>Price:</strong> <%= number_to_currency(course.price, unit: '₹') %><br>
          <%= form_with url: buy_course_path(course), method: :post, local: true, html: { "data-turbo" => "false" } do |f| %>
            <%= hidden_field_tag :course_id, course.id %>
            <%= hidden_field_tag :course_price, (course.price * 100).to_i %>
            <%= f.submit 'Buy', class: 'btn btn-primary' %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>