<h1>Welcome to the Tutor Portal</h1>

<% if tutor_signed_in? %>
  <div>
    <p>Welcome: <%= "#{current_tutor.first_name} #{current_tutor.last_name}" %></p>
  </div>
  <div>
    <%= link_to 'Show All Courses', tutor_courses_path(tutor_id: current_tutor.id) %>
  </div>
  <div>
    <%= link_to 'Create Course', new_tutor_course_path(tutor_id: current_tutor.id) %>
  </div>
  <div>
    <%= link_to 'Edit Profile', edit_tutor_registration_path %>
  </div>
  <div>
    <%= link_to 'Sign Out', destroy_tutor_session_path, data: { turbo_method: :delete } %>
  </div>
<% else %>
  <div>
    <%= link_to 'Log In', new_tutor_session_path %>
  </div>
  <div>
    <%= link_to 'Sign Up', new_tutor_registration_path %>
  </div>
<% end %>
